{
  "name": "vdrop-windows",
  "private": true,
  "version": "0.1.0",
  "description": "Windows batch downloader for yt-dlp with a Fluent-style UI.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.2.4",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.wavideo.vdropwindows",
    "productName": "vDrop Windows",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vDrop Windows",
      "deleteAppDataOnUninstall": false
    }
  }
}
